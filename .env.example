DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hsa_portal"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret"
BOOTSTRAP_ADMIN_EMAILS="admin@your-company.com"
PLAN_YEAR="2026"

# ----------------------------------------------------------------------------
# File storage
# ----------------------------------------------------------------------------
# STORAGE_PROVIDER selects where claim documents are stored: "local" | "s3"
STORAGE_PROVIDER="local"
# Required only when STORAGE_PROVIDER=s3
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional: custom endpoint for S3-compatible storage (e.g. MinIO, R2)
S3_ENDPOINT=""
# TTL (seconds) for signed download URLs
S3_SIGNED_URL_TTL_SECONDS="300"

# ----------------------------------------------------------------------------
# API rate limiting
# ----------------------------------------------------------------------------
# Set to "false" to disable rate limiting entirely
RATE_LIMIT_ENABLED="true"
# Optional Upstash Redis backend (recommended for multi-instance production).
# When unset, an in-memory limiter is used (suitable for single instance/dev).
RATE_LIMIT_REDIS_URL=""
RATE_LIMIT_REDIS_TOKEN=""
# Optional overrides for per-window request caps
RATE_LIMIT_CLAIMS_MAX="10"
RATE_LIMIT_CLAIMS_WINDOW_MS="300000"
RATE_LIMIT_ADMIN_MAX="30"
RATE_LIMIT_ADMIN_WINDOW_MS="60000"
RATE_LIMIT_EXPORT_MAX="5"
RATE_LIMIT_EXPORT_WINDOW_MS="60000"
